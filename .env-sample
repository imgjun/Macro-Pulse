# Copy to .env and fill in your values, then run:
#   uv run python src/main.py --dry-run

# ─── Telegram Bot API (for SENDING reports) ───────────────────────────────────
# Bot token from @BotFather; Chat/channel ID to post reports into
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Telegram MTProto / Telethon (for READING @yakjangsu images) ─────────────
# 1. Go to https://my.telegram.org > API development tools
# 2. Create an app — copy the api_id (integer) and api_hash (hex string) below
# 3. Run `uv run python scripts/generate_session.py` once to get the session string
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_STRING=your_session_string_here
